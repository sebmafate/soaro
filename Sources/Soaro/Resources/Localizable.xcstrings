    "Containers, volumes and images with a tag are never removed here. Removing a tagged image means downloading it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container, Volumes und Images mit Tag werden hier nie entfernt. Wer ein Image mit Tag entfernt, muss es später erneut laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí nunca se eliminan contenedores, volúmenes ni imágenes con etiqueta. Eliminar una imagen con etiqueta significa volver a descargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conteneurs, les volumes et les images avec étiquette ne sont jamais supprimés ici. Supprimer une image avec étiquette oblige à la télécharger à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non vengono mai rimossi container, volumi e immagini con tag. Rimuovere un'immagine con tag significa doverla scaricare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナ、ボリューム、タグ付きイメージはここでは削除されません。タグ付きイメージを削除すると、再度ダウンロードが必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너, 볼륨, 태그가 있는 이미지는 여기서 삭제되지 않아요. 태그가 있는 이미지를 삭제하면 다시 내려받아야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contêineres, volumes e imagens com tag nunca são removidos aqui. Remover uma imagem com tag significa baixá-la de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不会删除容器、卷和带标签的镜像。删除带标签的镜像意味着之后需要重新下载。"
          }
        }
      }
    },
    "Containers, volumes and images with a tag are not touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container, Volumes und Images mit Tag bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se tocan los contenedores, los volúmenes ni las imágenes con etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conteneurs, les volumes et les images avec étiquette ne sont pas touchés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Container, volumi e immagini con tag non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナ、ボリューム、タグ付きイメージには手を加えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너, 볼륨, 태그가 있는 이미지는 건드리지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contêineres, volumes e imagens com tag não são tocados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器、卷和带标签的镜像不会被改动。"
          }
        }
      }
    },
