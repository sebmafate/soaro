    "Downloaded packages, downloaded again when needed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Pakete, werden bei Bedarf erneut geladen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes descargados, se vuelven a descargar si hace falta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets téléchargés, re-téléchargés au besoin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti scaricati, scaricati di nuovo quando servono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード済みのパッケージ。必要に応じて再ダウンロードされます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
