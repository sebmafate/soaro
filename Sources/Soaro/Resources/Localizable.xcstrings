    "Updates fix security flaws and performance problems. You are running macOS %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates beheben Sicherheitslücken und Leistungsprobleme. Sie verwenden macOS %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones corrigen fallos de seguridad y problemas de rendimiento. Estás usando macOS %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour corrigent des failles de sécurité et des problèmes de performance. Vous utilisez macOS %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aggiornamenti correggono vulnerabilità di sicurezza e problemi di prestazioni. Stai usando macOS %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートでは、セキュリティ上の問題やパフォーマンスの問題が修正されます。現在お使いの macOS は %@ です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트는 보안 취약점과 성능 문제를 해결해요. 현재 macOS %@을(를) 사용 중이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações corrigem falhas de segurança e problemas de desempenho. Você está usando o macOS %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新可修复安全漏洞和性能问题。您当前运行的是 macOS %@。"
