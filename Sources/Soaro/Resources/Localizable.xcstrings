    "%@ of free space left. Storage settings offer to move files to iCloud and remove movies you have already watched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@ freier Speicherplatz. In den Speichereinstellungen können Sie Dateien in iCloud auslagern und bereits angesehene Filme entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan %@ de espacio libre. Los ajustes de Almacenamiento permiten mover archivos a iCloud y eliminar las películas que ya has visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %@ d'espace libre. Les réglages Stockage proposent de déplacer des fichiers vers iCloud et de retirer les films déjà regardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano %@ di spazio libero. Le impostazioni di Archiviazione permettono di spostare file su iCloud e rimuovere i film già guardati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量は残り %@ です。ストレージ設定では、ファイルを iCloud に移動したり、視聴済みのムービーを削除したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간이 %@ 남았어요. 저장 공간 설정에서 파일을 iCloud로 옮기고 이미 본 영화를 삭제할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam %@ de espaço livre. Os ajustes de Armazenamento permitem mover arquivos para o iCloud e remover filmes que você já assistiu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余可用空间 %@。“储存空间”设置可将文件移到 iCloud，并移除您已观看的影片。"
          }
        }
      }
    },
    "%@ of free space left. macOS can delete items that stayed in the Trash for more than 30 days (Finder › Settings › Advanced).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@ freier Speicherplatz. macOS kann Objekte, die länger als 30 Tage im Papierkorb liegen, automatisch löschen (Finder › Einstellungen › Erweitert)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan %@ de espacio libre. macOS puede eliminar automáticamente los elementos que llevan más de 30 días en la Papelera (Finder › Ajustes › Avanzado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %@ d'espace libre. macOS peut supprimer seul les éléments restés plus de 30 jours dans la corbeille (Finder › Réglages › Options avancées)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano %@ di spazio libero. macOS può eliminare automaticamente gli elementi rimasti nel Cestino da più di 30 giorni (Finder › Impostazioni › Avanzate)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量は残り %@ です。macOS は 30 日以上ゴミ箱に入っている項目を自動的に削除できます（Finder › 設定 › 詳細）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간이 %@ 남았어요. macOS는 휴지통에 30일 넘게 있던 항목을 자동으로 삭제할 수 있어요 (Finder › 설정 › 고급)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam %@ de espaço livre. O macOS pode apagar itens que ficaram na Lixeira por mais de 30 dias (Finder › Ajustes › Avançado)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余可用空间 %@。macOS 可自动删除在废纸篓中超过 30 天的项目（访达 › 设置 › 高级）。"
          }
        }
      }
    },
