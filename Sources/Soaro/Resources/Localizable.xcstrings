    "“Allow in the Background” apps can only be managed in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps unter „Im Hintergrund erlauben“ lassen sich nur in den Systemeinstellungen verwalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps de «Permitir en segundo plano» solo se pueden gestionar en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les « apps en arrière-plan » ne peuvent se gérer que dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app «Consenti in background» si gestiscono solo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「バックグラウンドで許可」のAppは、システム設定でのみ管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“백그라운드에서 허용” 앱은 시스템 설정에서만 관리할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps “Permitir em Segundo Plano” só podem ser gerenciados nos Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“允许在后台”的 App 只能在“系统设置”中管理。"
          }
        }
      }
    },
    "Soaro only cleans Docker on this Mac. The selected Docker engine or builder is not local.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro bereinigt Docker nur auf diesem Mac. Die ausgewählte Docker-Engine oder der ausgewählte Builder ist nicht lokal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro solo limpia Docker en este Mac. El motor o el builder de Docker seleccionado no es local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro ne nettoie Docker que sur ce Mac. Le moteur ou le builder Docker sélectionné n'est pas local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro pulisce Docker solo su questo Mac. Il motore o il builder Docker selezionato non è locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro はこの Mac 上の Docker だけをクリーンアップします。選択中の Docker エンジンまたはビルダーはローカルではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro는 이 Mac의 Docker만 정리해요. 선택된 Docker 엔진 또는 빌더가 로컬이 아니에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Soaro só limpa o Docker neste Mac. O motor ou o builder do Docker selecionado não é local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro 只会清理这台 Mac 上的 Docker。所选的 Docker 引擎或构建器不是本地的。"
          }
        }
      }
    },
