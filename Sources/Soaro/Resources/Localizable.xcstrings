          "stringUnit": {
            "state": "translated",
            "value": "该 App 将不再在登录时打开，但不会被删除。"
          }
        }
      }
    },
    "The next build will be slower, because the cache is rebuilt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der nächste Build dauert länger, weil der Cache neu aufgebaut wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima compilación será más lenta porque se reconstruye la caché."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain build sera plus lent, car le cache est reconstruit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo build sarà più lento perché la cache viene ricreata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュが再作成されるため、次回のビルドは遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시를 다시 만들기 때문에 다음 빌드가 더 느려져요."
