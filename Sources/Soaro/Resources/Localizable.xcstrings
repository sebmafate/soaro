    "Xcode’s simulator service did not answer. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Simulator-Dienst von Xcode antwortet nicht. Versuchen Sie es in einem Moment erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de simuladores de Xcode no respondió. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de simulateurs d'Xcode n'a pas répondu. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio simulatori di Xcode non ha risposto. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode のシミュレータサービスが応答しませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode의 시뮬레이터 서비스가 응답하지 않았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de simuladores do Xcode não respondeu. Tente de novo em instantes."
          }
        },
        "zh-Hans": {
