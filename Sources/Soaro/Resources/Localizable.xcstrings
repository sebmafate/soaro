    "The app and its related items (%lld) will be moved to the Trash (%@). You can recover them until the Trash is emptied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App und ihre zugehörigen Objekte (%lld) werden in den Papierkorb gelegt (%@). Sie können sie zurückholen, bis der Papierkorb entleert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app y sus elementos asociados (%lld) se moverán a la Papelera (%@). Podrás recuperarlos hasta que se vacíe la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application et %1$lld élément(s) associé(s) seront mis à la corbeille (%2$@). Vous pourrez les récupérer tant que la corbeille n'est pas vidée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app e i suoi elementi associati (%lld) verranno spostati nel Cestino (%@). Potrai recuperarli finché il Cestino non viene svuotato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appと関連項目（%lld 件）をゴミ箱に入れます（%@）。ゴミ箱を空にするまでは元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 관련 항목(%lld개)이 휴지통으로 이동돼요 (%@). 휴지통을 비우기 전에는 복원할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app e seus itens relacionados (%lld) serão movidos para a Lixeira (%@). Você poderá recuperá-los até que a Lixeira seja esvaziada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 及其相关项目（%lld）将被移到废纸篓（%@）。在清倒废纸篓之前，您都可以恢复它们。"
          }
        }
      }
    },
    "The app will no longer open at login. It is not deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wird nicht mehr beim Anmelden geöffnet. Sie wird nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app dejará de abrirse al iniciar sesión. No se elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application ne se lancera plus à l'ouverture de session. Elle n'est pas supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non si aprirà più al login. Non viene eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppはログイン時に開かなくなります。削除はされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 더 이상 로그인 시 열리지 않아요. 앱이 삭제되지는 않아요."
          }
        },
        "pt-BR": {
