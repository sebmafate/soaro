    "+%@ in %@, %@ now. Restarting it resets its counter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@ in %@, aktuell %@. Ein Neustart setzt den Zähler zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@ en %@, ahora %@. Reiniciarla pone su contador a cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "+%1$@ en %2$@, %3$@ actuellement. Le relancer remet son compteur à zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@ in %@, ora %@. Riavviarlo azzera il contatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ で +%1$@、現在 %3$@。再起動するとカウンタがリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 동안 +%1$@, 현재 %3$@. 다시 시작하면 카운터가 초기화돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "+%@ em %@, %@ agora. Reiniciá-lo zera o contador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 内增加 %@，目前为 %@。重新启动它可重置计数。"
          }
        }
      }
    },
