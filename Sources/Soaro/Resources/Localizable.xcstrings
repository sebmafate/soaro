    "Once a day, Soaro downloads a small public file from soaro.app to see if a new version exists. It sends no personal data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal täglich lädt Soaro eine kleine öffentliche Datei von soaro.app herunter, um zu prüfen, ob eine neue Version verfügbar ist. Es werden keine persönlichen Daten gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día, Soaro descarga un pequeño archivo público de soaro.app para saber si hay una versión nueva. No envía ningún dato personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, Soaro télécharge un petit fichier public depuis soaro.app pour savoir si une nouvelle version existe. Il n'envoie aucune donnée personnelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al giorno Soaro scarica un piccolo file pubblico da soaro.app per sapere se esiste una nuova versione. Non invia dati personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaroは1日に1回、soaro.appから小さな公開ファイルをダウンロードして、新しいバージョンがあるか確認します。個人データは送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro는 하루에 한 번 soaro.app에서 작은 공개 파일을 내려받아 새 버전이 있는지 확인합니다. 개인 데이터는 전송하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por dia, o Soaro baixa um pequeno arquivo público de soaro.app para saber se há uma nova versão. Ele não envia dados pessoais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Soaro 每天会从 soaro.app 下载一个小型公开文件，以检查是否有新版本。不会发送任何个人数据。"
          }
        }
      }
    },
    "Only %@ (%@) left. The system slows down when the disk is full.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur noch %@ (%@) frei. Das System wird langsamer, wenn die Festplatte voll ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quedan %@ (%@). El sistema se ralentiza cuando el disco está lleno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne reste que %1$@ (%2$@). Le système ralentit quand le disque est saturé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restano solo %@ (%@). Il sistema rallenta quando il disco è pieno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りは %@（%@）のみです。ディスクがいっぱいになると、システムの動作が遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)만 남았어요. 디스크가 가득 차면 시스템이 느려져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam apenas %@ (%@). O sistema fica mais lento quando o disco está cheio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅剩 %@（%@）。磁盘已满时系统会变慢。"
          }
        }
      }
    },
    "Open Storage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher öffnen"
          }
        },
        "es": {
