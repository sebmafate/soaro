    },
    "The system is slowing down to cool off. Close heavy tasks and let the machine breathe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System drosselt die Leistung, um sich abzukühlen. Beenden Sie rechenintensive Aufgaben und lassen Sie den Mac durchatmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema está reduciendo su rendimiento para enfriarse. Cierra las tareas pesadas y deja que el equipo respire."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système réduit les performances pour se refroidir. Fermez les tâches lourdes et aérez la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema sta rallentando per raffreddarsi. Chiudi le attività pesanti e lascia respirare il Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは冷却のために動作を抑えています。負荷の高い作業を閉じて、Macを休ませてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 열을 식히기 위해 성능을 낮추고 있어요. 무거운 작업을 종료하고 기기를 식혀주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema está reduzindo o desempenho para esfriar. Feche as tarefas pesadas e deixe o Mac respirar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统正在降速以散热。请关闭高负载任务，让机器散散热。"
          }
        }
      }
    },
