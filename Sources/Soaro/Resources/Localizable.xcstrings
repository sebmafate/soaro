    "Projects inactive for more than %lld days are pre-selected. These folders can be rebuilt with “npm install”, “swift build”, and so on; your sources are never touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte, die seit mehr als %lld Tagen inaktiv sind, sind vorausgewählt. Diese Ordner lassen sich mit „npm install“, „swift build“ usw. neu erstellen; Ihre Quelldateien werden nie angetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos inactivos desde hace más de %lld días vienen preseleccionados. Estas carpetas se recrean con «npm install», «swift build», etc.; tus fuentes nunca se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets inactifs depuis plus de %lld jours sont pré-sélectionnés. Ces dossiers se recréent avec « npm install », « swift build », etc. ; vos sources ne sont jamais touchées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti inattivi da più di %lld giorni sono preselezionati. Queste cartelle si ricreano con «npm install», «swift build» e così via; i tuoi file sorgente non vengono mai toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日を超えて使われていないプロジェクトはあらかじめ選択されています。これらのフォルダは「npm install」や「swift build」などで再生成できます。ソースには一切手を加えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld일 넘게 사용하지 않은 프로젝트는 미리 선택돼요. 이 폴더들은 “npm install”, “swift build” 등으로 다시 만들 수 있으며, 소스는 절대 건드리지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetos inativos há mais de %lld dias são pré-selecionados. Essas pastas podem ser recriadas com “npm install”, “swift build” e assim por diante; seus códigos-fonte nunca são alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "闲置超过 %lld 天的项目已被预先选中。这些文件夹可通过“npm install”、“swift build”等命令重新生成；您的源代码绝不会被改动。"
          }
        }
      }
    },
    "Prolonged heat wears the battery faster. Avoid charging under a cushion or in the sun.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhaltende Hitze nutzt die Batterie schneller ab. Vermeiden Sie das Laden unter einem Kissen oder in der Sonne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calor prolongado desgasta la batería más rápido. Evita cargarla bajo un cojín o al sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chaleur prolongée use la batterie plus vite. Évitez de charger sous un coussin ou au soleil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calore prolungato usura più in fretta la batteria. Evita di caricarla sotto un cuscino o al sole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高温が続くと、バッテリーの劣化が早まります。クッションの下や日なたでの充電は避けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열이 오래 지속되면 배터리가 더 빨리 노후돼요. 쿠션 아래나 햇볕 아래에서 충전하지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O calor prolongado desgasta a bateria mais rápido. Evite carregar sob uma almofada ou ao sol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间高温会加速电池损耗。请避免在垫子下或阳光下充电。"
          }
        }
      }
    },
