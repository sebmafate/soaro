          }
        }
      }
    },
    "%lld charge cycles. Below 80 %%, Apple considers the battery consumed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ladezyklen. Unter 80 %% gilt die Batterie laut Apple als verbraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ciclos de carga. Por debajo del 80 %%, Apple considera la batería consumida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cycles de charge. En dessous de 80 %%, Apple considère la batterie comme consommée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cicli di carica. Sotto l'80 %%, Apple considera la batteria esaurita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電回数は %lld 回です。80 %% を下回ると、Apple はバッテリーが消耗したものと見なします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 사이클 %lld회. 80%% 미만이면 Apple은 배터리가 소모된 것으로 봐요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ciclos de carga. Abaixo de 80 %%, a Apple considera a bateria consumida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次充电循环。低于 80%% 时，Apple 认为电池已耗损。"
