    "Docker did not answer. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker antwortet nicht. Versuchen Sie es in einem Moment erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker no respondió. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
