{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\n\nAbout %@ will be freed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEtwa %@ werden freigegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nSe liberarán unos %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nEnviron %@ seront libérés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nVerranno liberati circa %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n約 %@ を解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n약 %@의 공간이 확보돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nCerca de %@ serão liberados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\n大约可释放 %@。"
          }
        }
      }
    },
    "\nEmptying the Trash is permanent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nDas Entleeren des Papierkorbs kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nVaciar la Papelera es definitivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLa suppression de la corbeille est définitive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\nSvuotare il Cestino è un'azione definitiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\nゴミ箱を空にすると元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n휴지통을 비우면 되돌릴 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\nEsvaziar a Lixeira é permanente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n清倒废纸篓后无法恢复。"
          }
        }
      }
    },
    " (%lld items in use were skipped)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld verwendete Objekte übersprungen)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld elementos en uso omitidos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld éléments en cours d'utilisation ignorés)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld elementi in uso ignorati)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（使用中の %lld 項目をスキップしました）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " (사용 중인 항목 %lld개는 건너뛰었어요)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " (%lld itens em uso foram ignorados)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（已跳过 %lld 个正在使用的项目）"
          }
        }
      }
    },
    "%@ %@": {},
