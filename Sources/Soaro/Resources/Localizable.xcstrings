    "Access denied. Allow Soaro to control “System Events” in System Settings › Privacy & Security › Automation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff verweigert. Erlauben Sie Soaro in Systemeinstellungen › Datenschutz & Sicherheit › Automation, „System Events“ zu steuern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso denegado. Permite que Soaro controle «System Events» en Ajustes del Sistema › Privacidad y seguridad › Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès refusé. Autorisez Soaro à contrôler « System Events » dans Réglages Système › Confidentialité › Automatisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso negato. Consenti a Soaro di controllare «System Events» in Impostazioni di Sistema › Privacy e sicurezza › Automazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが拒否されました。システム設定 › プライバシーとセキュリティ › オートメーションで、Soaro に「System Events」の制御を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근이 거부되었어요. 시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 Soaro가 “System Events”를 제어하도록 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso negado. Permita que o Soaro controle o “System Events” em Ajustes do Sistema › Privacidade e Segurança › Automação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问被拒绝。请在“系统设置” › “隐私与安全性” › “自动化”中允许 Soaro 控制“System Events”。"
          }
        }
      }
    },
