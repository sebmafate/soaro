    "%@ seems to be leaking memory": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat anscheinend ein Speicherleck"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parece perder memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ semble fuir de la mémoire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sembra perdere memoria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でメモリリークが発生している可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 메모리 누수가 의심돼요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parece estar vazando memória"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 似乎存在内存泄漏"
          }
        }
      }
    },
    "%@ uses %@. Quitting it would free up memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belegt %@. Das Beenden würde Arbeitsspeicher freigeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ocupa %@. Salir de la app liberaría memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ occupe %2$@. Le quitter libérerait de la mémoire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa %@. Chiuderla libererebbe memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が %@ を使用しています。終了するとメモリを解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 %@을(를) 사용 중이에요. 종료하면 메모리를 확보할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa %@. Encerrá-lo liberaria memória."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 占用 %@。退出它可释放内存。"
          }
        }
      }
    },
    "%@ will be freed once the Trash is emptied. You can still recover them from the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ werden freigegeben, sobald der Papierkorb entleert wird. Sie können sie bis dahin aus dem Papierkorb zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se liberarán %@ cuando se vacíe la Papelera. Aún puedes recuperarlos desde la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront libérés une fois la corbeille vidée. Vous pouvez encore les récupérer depuis la corbeille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno liberati %@ una volta svuotato il Cestino. Puoi ancora recuperarli dal Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にすると %@ を解放できます。それまではゴミ箱から元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우면 %@의 공간이 확보돼요. 그 전에는 휴지통에서 복원할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão liberados quando a Lixeira for esvaziada. Você ainda pode recuperá-los da Lixeira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清倒废纸篓后将释放 %@。在此之前仍可从废纸篓中恢复。"
          }
        }
      }
    },
    "%@ will be freed. The devices, the apps and data on them, and their snapshots will be deleted. You can create new devices from Xcode or Android Studio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ werden freigegeben. Die Geräte, ihre Apps und Daten sowie ihre Schnappschüsse werden gelöscht. Neue Geräte können Sie in Xcode oder Android Studio anlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se liberarán %@. Se eliminarán los dispositivos, las apps y los datos que contienen, y sus instantáneas. Puedes crear dispositivos nuevos desde Xcode o Android Studio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront libérés. Les appareils, les apps et les données qu'ils contiennent, ainsi que leurs instantanés, seront supprimés. Vous pouvez créer de nouveaux appareils depuis Xcode ou Android Studio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno liberati %@. I dispositivi, le app e i dati al loro interno e le relative istantanee verranno eliminati. Puoi creare nuovi dispositivi da Xcode o Android Studio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を解放します。デバイス、その中のアプリとデータ、およびスナップショットが削除されます。新しいデバイスは Xcode または Android Studio から作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 공간을 확보합니다. 기기와 그 안의 앱 및 데이터, 스냅샷이 삭제됩니다. 새 기기는 Xcode나 Android Studio에서 만들 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão liberados. Os dispositivos, os apps e os dados neles, e seus snapshots serão apagados. Você pode criar novos dispositivos pelo Xcode ou Android Studio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将释放 %@。设备、其中的 App 和数据以及快照都会被删除。你可以在 Xcode 或 Android Studio 中新建设备。"
          }
        }
      }
    },
    "%@ will be freed. Your sources are not touched: just run “npm install”, “swift build”… to rebuild them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ werden freigegeben. Ihre Quelldateien bleiben unberührt: Mit „npm install“, „swift build“ usw. stellen Sie die Ordner wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se liberarán %@. Tus fuentes no se tocan: bastará con volver a ejecutar «npm install», «swift build»… para recrearlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront libérés. Vos sources ne sont pas touchées : il suffira de relancer « npm install », « swift build »… pour les recréer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno liberati %@. I tuoi file sorgente non vengono toccati: basterà rilanciare «npm install», «swift build»… per ricrearli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を解放します。ソースには影響しません。「npm install」や「swift build」などを実行すれば再生成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 공간이 확보돼요. 소스는 건드리지 않아요. “npm install”, “swift build” 등을 다시 실행하면 복구돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão liberados. Seus códigos-fonte não são alterados: basta executar “npm install”, “swift build”… para recriá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将释放 %@。您的源代码不受影响：只需运行“npm install”、“swift build”等命令即可重新生成。"
          }
        }
      }
    },
