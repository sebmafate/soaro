    "%@ has been using about %lld %% CPU for a while.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nutzt seit einiger Zeit etwa %lld %% CPU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lleva un rato usando alrededor del %lld %% de la CPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ utilise environ %2$lld %% de CPU depuis un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa circa il %lld %% di CPU da un po'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はしばらく前から CPU を約 %lld %% 使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 한동안 CPU를 약 %lld%% 사용하고 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está usando cerca de %lld %% da CPU há algum tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已持续占用约 %lld%% 的 CPU。"
          }
        }
      }
    },
    "%@ is preventing sleep": {
      "localizations": {
        "de": {
          "stringUnit": {
