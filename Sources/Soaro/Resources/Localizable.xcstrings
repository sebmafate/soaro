          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes baixados, baixados novamente quando necessário"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的软件包，需要时会重新下载"
          }
        }
      }
    },
    "Each one slows down startup and keeps using memory. Many are automatic updaters for apps you may no longer use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Element verlängert den Startvorgang und belegt dauerhaft Arbeitsspeicher. Viele sind automatische Updater für Apps, die Sie vielleicht nicht mehr verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada uno ralentiza el arranque y ocupa memoria de forma permanente. Muchos son actualizadores automáticos de apps que quizá ya no uses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun allonge le démarrage et occupe de la mémoire en permanence. Beaucoup sont des mises à jour automatiques d'applications que vous n'utilisez peut-être plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ognuno rallenta l'avvio e occupa memoria in modo continuo. Molti sono aggiornamenti automatici di app che forse non usi più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どれも起動を遅くし、メモリを使い続けます。多くは、使っていない可能性のあるAppの自動アップデータです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 항목은 시동 속도를 늦추고 계속 메모리를 사용해요. 대부분 더 이상 쓰지 않는 앱의 자동 업데이트 프로그램이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada um deixa a inicialização mais lenta e continua usando memória. Muitos são atualizadores automáticos de apps que você talvez não use mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一项都会拖慢启动速度并持续占用内存。其中许多是您可能已不再使用的 App 的自动更新程序。"
          }
        }
      }
    },
