    "Physical interfaces only (Wi-Fi, Ethernet): VPN traffic is not counted twice.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur physische Schnittstellen (Wi-Fi, Ethernet): VPN-Verkehr wird nicht doppelt gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo interfaces físicas (Wi-Fi, Ethernet): el tráfico de VPN no se cuenta dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfaces physiques uniquement (Wi-Fi, Ethernet) : le trafic des VPN n'est pas compté deux fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo interfacce fisiche (Wi-Fi, Ethernet): il traffico VPN non viene conteggiato due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理インターフェイスのみ（Wi-Fi、Ethernet）。VPN の通信は二重に集計されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리 인터페이스만 포함해요 (Wi-Fi, 이더넷). VPN 트래픽은 중복 집계되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente interfaces físicas (Wi-Fi, Ethernet): o tráfego de VPN não é contado duas vezes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限物理接口（Wi-Fi、以太网）：VPN 流量不会重复计算。"
          }
        }
      }
    },
    "Plug in the charger to avoid a shutdown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie das Ladegerät an, um ein Ausschalten zu vermeiden."
          }
        },
        "es": {
