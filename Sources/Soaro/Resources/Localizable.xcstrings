    "Docker reported %@. The space returned to this Mac could not be measured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker meldete %@. Der an diesen Mac zurückgegebene Platz konnte nicht gemessen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker indicó %@. No se pudo medir el espacio devuelto a este Mac."
