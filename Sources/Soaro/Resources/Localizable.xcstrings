    "%@: sleep blocked for %@. The Mac does not fall asleep by itself, which uses energy and drains the battery when unplugged. Close the app if this is not intended.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Ruhezustand seit %@ blockiert. Der Mac schläft nicht von selbst ein, was Energie verbraucht und die Batterie entlädt, wenn er nicht angeschlossen ist. Beenden Sie die App, falls dies nicht beabsichtigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: reposo bloqueado desde hace %@. El Mac no entra en reposo por sí solo, lo que consume energía y agota la batería si no está conectado. Cierra la app si no es intencionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ : veille bloquée depuis %2$@. Le Mac ne s'endort pas tout seul, ce qui consomme de l'énergie et vide la batterie s'il n'est pas branché. Fermez l'app si ce n'est pas voulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: stop bloccato da %@. Il Mac non va in stop da solo, il che consuma energia e scarica la batteria se non è collegato. Chiudi l'app se non è voluto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%@ のあいだスリープが妨げられています。Mac が自動的にスリープしないため、電力を消費し、電源に接続していないとバッテリーが減ります。意図していない場合は App を閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@ 동안 잠자기가 차단되었어요. Mac이 저절로 잠자기 상태가 되지 않아 에너지를 쓰고, 전원에 연결하지 않으면 배터리가 소모돼요. 의도한 것이 아니라면 앱을 종료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: repouso bloqueado há %@. O Mac não entra em repouso sozinho, o que consome energia e descarrega a bateria quando não está conectado. Feche o app se isso não for intencional."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：已阻止睡眠 %@。Mac 不会自动进入睡眠，这会消耗能源，并在未接电源时耗尽电池。如非有意为之，请关闭该 App。"
          }
        }
      }
    },
    "%lld %% battery left. This mode lowers brightness and background activity to extend battery life.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %lld %% Batterie. Dieser Modus reduziert Helligkeit und Hintergrundaktivität, um die Batterielaufzeit zu verlängern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda el %lld %% de batería. Este modo reduce el brillo y la actividad en segundo plano para ganar autonomía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste %lld %% de batterie. Ce mode réduit la luminosité et l'activité en arrière-plan pour gagner de l'autonomie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta il %lld %% di batteria. Questa modalità riduce la luminosità e l'attività in background per prolungare l'autonomia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量は %lld %% です。このモードでは、輝度とバックグラウンドの動作を抑えてバッテリーの持ちを延ばします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 %lld%% 남았어요. 이 모드는 밝기와 백그라운드 활동을 줄여 배터리 사용 시간을 늘려줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restam %lld %% de bateria. Este modo reduz o brilho e a atividade em segundo plano para aumentar a autonomia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
